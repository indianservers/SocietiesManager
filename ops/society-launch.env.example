# Deployment configuration; replace the tenant ID after creating the society.
# To serve another society, change configuration and data rather than app code.
PublicUrl=https://members.aimersociety.com
Society__DefaultTenantId=REPLACE_WITH_APPROVED_SOCIETY_TENANT_UUID
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=members.aimersociety.com
